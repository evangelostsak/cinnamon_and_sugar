# Security headers and caching for Cloudflare Pages. Edited by hand, except
# the inline-script hash, which tools/build.js keeps in step with the page.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'sha256-fiaIQZm8I5rbNkshZPeROGU2sYNmiZCNIGv6QyH9OL0='; style-src 'self'; font-src 'self'; img-src 'self'; frame-src https://www.openstreetmap.org; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: off

/source/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/source/images/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/source/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/source/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/source/i18n/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/api/*
  X-Robots-Tag: noindex

/functions/*
  X-Robots-Tag: noindex

/tools/*
  X-Robots-Tag: noindex

/source/pages/*
  X-Robots-Tag: noindex
